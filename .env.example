# ===========================================
# Schoolify Frontend - Environment Variables
# ===========================================

# Backend API URL (Client-side requests)
NEXT_PUBLIC_BE_URL="http://localhost:3005"

# Backend API URL (Optional server-side direct access)
BE_URL="http://localhost:3005"

# Google OAuth2 Client ID (for Google Login button)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Cloudinary Storage Configuration (Tải ảnh bình luận / bài giải lên Cloudinary)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
